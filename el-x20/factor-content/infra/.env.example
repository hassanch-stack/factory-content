# Factor Content — variables de entorno
# Copiar a .env y rellenar. NUNCA commitear .env con valores reales.

# --- Database ---
DATABASE_URL=postgresql+psycopg://factor:factor_dev_password@postgres:5432/factor_content

# --- Queue ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (S3-compatible; Cloudflare R2 en producción, MinIO en local) ---
S3_ENDPOINT=http://minio:9000
S3_BUCKET=factor-content-dev
S3_ACCESS_KEY=factor_dev
S3_SECRET_KEY=factor_dev_password
S3_REGION=auto

# --- Auth ---
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
AUTH_REQUIRED=false
# Alternativa recomendada en vez de auth casera: Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cifrado de credenciales de plataforma (platform_credentials.encrypted_payload) ---
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- AI (solo metadata/caption/transcripción, nunca vídeo — ver ADR/spec punto 32) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/webhooks/tiktok/callback

# --- Meta (Instagram/Facebook Graph API) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/webhooks/meta/callback

# --- Observability ---
SENTRY_DSN=
ENVIRONMENT=development
LOG_LEVEL=info
MAX_UPLOAD_SIZE_BYTES=20971520

# --- App ---
NEXT_PUBLIC_API_URL=http://localhost:8000
